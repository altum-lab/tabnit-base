# 제조 안전 Pack. 반도체 제조 현장의 안전·보건·환경 업무를 본뜬 예시 Pack 이다 (D2 AD-49, AD-284 ~ AD-288).
# 모든 이름과 값은 지어낸 것이다. 실제 회사, 현장, 법령, 문서와 관계가 없다.
# 입력 자료 emission-point: 배출구의 목록.
@prefix tabnit: <urn:tabnit:vocab:> .
@prefix ex:     <urn:tabnit:pack:manufacturing-safety:> .

ex:매핑-emission-point a tabnit:Mapping ;
    tabnit:inputSourceId "emission-point" ;
    tabnit:fileFormat tabnit:Csv ;
    tabnit:requiredColumns ( "배출구번호" "배출구명칭" ) ;
    tabnit:itemKeyColumns ( "배출구번호" ) ;
    # 이 행이 나타내는 개체. 이 행에서 나온 변동의 근거가 된다 (D2 AD-120).
    tabnit:primaryEntity [ tabnit:entityType ex:대기배출구 ; tabnit:keyColumn "배출구번호" ] ;
    tabnit:entity [
        tabnit:entityType ex:대기배출구 ;
        tabnit:keyColumn "배출구번호" ;
        tabnit:attribute [ tabnit:property ex:배출구명칭 ; tabnit:column "배출구명칭" ]
    ] .
