# 제조 안전 Pack. 반도체 제조 현장의 안전·보건·환경 업무를 본뜬 예시 Pack 이다 (D2 AD-49, AD-284 ~ AD-288).
# 모든 이름과 값은 지어낸 것이다. 실제 회사, 현장, 법령, 문서와 관계가 없다.
# 입력 자료 permit: 작업 허가와 그 대상 공정.
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tabnit: <urn:tabnit:vocab:> .
@prefix ex:     <urn:tabnit:pack:manufacturing-safety:> .

ex:매핑-permit a tabnit:Mapping ;
    tabnit:inputSourceId "permit" ;
    rdfs:label "작업허가 목록" ;
    tabnit:fileFormat tabnit:Csv ;
    tabnit:requiredColumns ( "허가번호" "허가종류" "대상공정" ) ;
    tabnit:itemKeyColumns ( "허가번호" ) ;
    # 이 행이 나타내는 개체. 이 행에서 나온 변동의 근거가 된다 (D2 AD-120).
    tabnit:primaryEntity [ tabnit:entityType ex:작업허가 ; tabnit:keyColumn "허가번호" ] ;
    tabnit:entity [
        tabnit:entityType ex:작업허가 ;
        tabnit:keyColumn "허가번호" ;
        tabnit:attribute [ tabnit:property ex:허가종류 ; tabnit:column "허가종류" ]
    ] ;
    tabnit:relation [
        tabnit:relationType ex:허가대상 ;
        tabnit:sourceEntity [ tabnit:entityType ex:작업허가 ; tabnit:keyColumn "허가번호" ] ;
        tabnit:targetEntity [ tabnit:entityType ex:제조공정 ; tabnit:keyColumn "대상공정" ]
    ] .
