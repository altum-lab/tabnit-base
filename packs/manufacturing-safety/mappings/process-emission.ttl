# 제조 안전 Pack. 반도체 제조 현장의 안전·보건·환경 업무를 본뜬 예시 Pack 이다 (D2 AD-49, AD-284 ~ AD-288).
# 모든 이름과 값은 지어낸 것이다. 실제 회사, 현장, 법령, 문서와 관계가 없다.
# 입력 자료 process-emission: 공정의 배기가 나가는 배출구.
@prefix tabnit: <urn:tabnit:vocab:> .
@prefix ex:     <urn:tabnit:pack:manufacturing-safety:> .

ex:매핑-process-emission a tabnit:Mapping ;
    tabnit:inputSourceId "process-emission" ;
    tabnit:fileFormat tabnit:Csv ;
    tabnit:requiredColumns ( "공정번호" "배출구번호" ) ;
    tabnit:itemKeyColumns ( "공정번호" "배출구번호" ) ;
    # 이 행이 나타내는 개체. 이 행에서 나온 변동의 근거가 된다 (D2 AD-120).
    tabnit:primaryEntity [ tabnit:entityType ex:제조공정 ; tabnit:keyColumn "공정번호" ] ;
    tabnit:relation [
        tabnit:relationType ex:배기연결 ;
        tabnit:sourceEntity [ tabnit:entityType ex:제조공정 ; tabnit:keyColumn "공정번호" ] ;
        tabnit:targetEntity [ tabnit:entityType ex:대기배출구 ; tabnit:keyColumn "배출구번호" ]
    ] .
