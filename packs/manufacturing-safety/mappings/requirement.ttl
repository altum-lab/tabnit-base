# 제조 안전 Pack. 반도체 제조 현장의 안전·보건·환경 업무를 본뜬 예시 Pack 이다 (D2 AD-49, AD-284 ~ AD-288).
# 모든 이름과 값은 지어낸 것이다. 실제 회사, 현장, 법령, 문서와 관계가 없다.
# 입력 자료 requirement: 요건의 목록과, 요건을 부과한 법규.
@prefix tabnit: <urn:tabnit:vocab:> .
@prefix ex:     <urn:tabnit:pack:manufacturing-safety:> .

ex:매핑-requirement a tabnit:Mapping ;
    tabnit:inputSourceId "requirement" ;
    tabnit:fileFormat tabnit:Csv ;
    tabnit:requiredColumns ( "요건번호" "요건명칭" "요건구분" "근거법규" ) ;
    tabnit:itemKeyColumns ( "요건번호" ) ;
    # 이 행이 나타내는 개체. 이 행에서 나온 변동의 근거가 된다 (D2 AD-120).
    tabnit:primaryEntity [ tabnit:entityType ex:법정요건 ; tabnit:keyColumn "요건번호" ] ;
    tabnit:entity [
        tabnit:entityType ex:법정요건 ;
        tabnit:keyColumn "요건번호" ;
        tabnit:attribute [ tabnit:property ex:요건명칭 ; tabnit:column "요건명칭" ] ;
        tabnit:attribute [ tabnit:property ex:요건구분 ; tabnit:column "요건구분" ]
    ] ;
    tabnit:relation [
        tabnit:relationType ex:요건부과 ;
        tabnit:sourceEntity [ tabnit:entityType ex:안전법규 ; tabnit:keyColumn "근거법규" ] ;
        tabnit:targetEntity [ tabnit:entityType ex:법정요건 ; tabnit:keyColumn "요건번호" ]
    ] .
