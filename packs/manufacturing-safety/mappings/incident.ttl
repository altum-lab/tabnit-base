# 제조 안전 Pack. 반도체 제조 현장의 안전·보건·환경 업무를 본뜬 예시 Pack 이다 (D2 AD-49, AD-284 ~ AD-288).
# 모든 이름과 값은 지어낸 것이다. 실제 회사, 현장, 법령, 문서와 관계가 없다.
# 입력 자료 incident: 사고의 기록과 관련된 설비. 관련된 물질은 입력 자료 incident-substance 가 넣는다.
@prefix tabnit: <urn:tabnit:vocab:> .
@prefix ex:     <urn:tabnit:pack:manufacturing-safety:> .

ex:매핑-incident a tabnit:Mapping ;
    tabnit:inputSourceId "incident" ;
    tabnit:fileFormat tabnit:Csv ;
    tabnit:requiredColumns ( "사고번호" "사고종류" "사고발생일" "관련설비" ) ;
    tabnit:itemKeyColumns ( "사고번호" ) ;
    # 이 행이 나타내는 개체. 이 행에서 나온 변동의 근거가 된다 (D2 AD-120).
    tabnit:primaryEntity [ tabnit:entityType ex:안전사고 ; tabnit:keyColumn "사고번호" ] ;
    tabnit:entity [
        tabnit:entityType ex:안전사고 ;
        tabnit:keyColumn "사고번호" ;
        tabnit:attribute [ tabnit:property ex:사고종류 ; tabnit:column "사고종류" ] ;
        tabnit:attribute [ tabnit:property ex:사고발생일 ; tabnit:column "사고발생일" ]
    ] ;
    tabnit:relation [
        tabnit:relationType ex:사고관련 ;
        tabnit:sourceEntity [ tabnit:entityType ex:안전사고 ; tabnit:keyColumn "사고번호" ] ;
        tabnit:targetEntity [ tabnit:entityType ex:공정설비 ; tabnit:keyColumn "관련설비" ]
    ] .
