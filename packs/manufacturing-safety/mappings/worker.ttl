# 제조 안전 Pack. 반도체 제조 현장의 안전·보건·환경 업무를 본뜬 예시 Pack 이다 (D2 AD-49, AD-284 ~ AD-288).
# 모든 이름과 값은 지어낸 것이다. 실제 회사, 현장, 법령, 문서와 관계가 없다.
# 입력 자료 worker: 인원의 목록과 배치된 공정. 배치 공정이 바뀌면 앞의 배치는 새 판의 적용일로 끝난다.
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tabnit: <urn:tabnit:vocab:> .
@prefix ex:     <urn:tabnit:pack:manufacturing-safety:> .

ex:매핑-worker a tabnit:Mapping ;
    tabnit:inputSourceId "worker" ;
    rdfs:label "작업인원 목록" ;
    tabnit:fileFormat tabnit:Csv ;
    tabnit:requiredColumns ( "사번" "인원이름" "인원역할" "교육이수일" "배치공정" ) ;
    tabnit:itemKeyColumns ( "사번" ) ;
    # 이 행이 나타내는 개체. 이 행에서 나온 변동의 근거가 된다 (D2 AD-120).
    tabnit:primaryEntity [ tabnit:entityType ex:작업인원 ; tabnit:keyColumn "사번" ] ;
    tabnit:entity [
        tabnit:entityType ex:작업인원 ;
        tabnit:keyColumn "사번" ;
        tabnit:attribute [ tabnit:property ex:인원이름 ; tabnit:column "인원이름" ] ;
        tabnit:attribute [ tabnit:property ex:인원역할 ; tabnit:column "인원역할" ] ;
        tabnit:attribute [ tabnit:property ex:교육이수일 ; tabnit:column "교육이수일" ]
    ] ;
    tabnit:relation [
        tabnit:relationType ex:인원배치 ;
        tabnit:sourceEntity [ tabnit:entityType ex:제조공정 ; tabnit:keyColumn "배치공정" ] ;
        tabnit:targetEntity [ tabnit:entityType ex:작업인원 ; tabnit:keyColumn "사번" ]
    ] .
