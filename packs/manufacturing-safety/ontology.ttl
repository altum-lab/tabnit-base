# 제조 안전 Pack. 반도체 제조 현장의 안전·보건·환경 업무를 본뜬 예시 Pack 이다 (D2 AD-49, AD-284 ~ AD-288).
# 모든 이름과 값은 지어낸 것이다. 실제 회사, 현장, 법령, 문서와 관계가 없다.
# 온톨로지: 개체 유형 11개와 상위 유형 하나, 관계 유형 11개, 속성.
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix tabnit: <urn:tabnit:vocab:> .
@prefix ex:     <urn:tabnit:pack:manufacturing-safety:> .


# ── 개체 유형 ──────────────────────────────────────────────

# 요건이 걸리고 사고에 관련되는 것들의 상위 유형. 이 유형의 개체를 직접 만들지는 않는다.
ex:안전관리대상 a owl:Class ;
    rdfs:label "안전 관리 대상" .

# 법규의 조 하나.
ex:안전법규 a owl:Class ;
    rdfs:label "안전 법규" ;
    tabnit:displayNameProperty ex:법규명칭 .

# 법규가 부과하는 의무 하나.
ex:법정요건 a owl:Class ;
    rdfs:label "법정 요건" ;
    tabnit:displayNameProperty ex:요건명칭 .

# 공정에서 쓰는 물질.
ex:화학물질 a owl:Class ;
    rdfs:label "화학물질" ;
    rdfs:subClassOf ex:안전관리대상 ;
    tabnit:displayNameProperty ex:물질명칭 .

# 공급사가 주는 물질의 안전 자료. 판이 바뀐다.
ex:물질안전자료 a owl:Class ;
    rdfs:label "물질안전자료" ;
    tabnit:displayNameProperty ex:유해성구분 .

# 동과 구역 단위의 공정.
ex:제조공정 a owl:Class ;
    rdfs:label "제조 공정" ;
    rdfs:subClassOf ex:안전관리대상 ;
    tabnit:displayNameProperty ex:공정명칭 .

# 공정을 이루는 설비 한 대.
ex:공정설비 a owl:Class ;
    rdfs:label "공정 설비" ;
    rdfs:subClassOf ex:안전관리대상 ;
    tabnit:displayNameProperty ex:설비종류 .

# 물질을 보관하는 곳.
ex:약품보관소 a owl:Class ;
    rdfs:label "약품 보관소" ;
    rdfs:subClassOf ex:안전관리대상 ;
    tabnit:displayNameProperty ex:보관소명칭 .

# 공정의 배기가 나가는 곳.
ex:대기배출구 a owl:Class ;
    rdfs:label "대기 배출구" ;
    rdfs:subClassOf ex:안전관리대상 ;
    tabnit:displayNameProperty ex:배출구명칭 .

# 공정에 배치된 사람.
ex:작업인원 a owl:Class ;
    rdfs:label "작업 인원" ;
    rdfs:subClassOf ex:안전관리대상 ;
    tabnit:displayNameProperty ex:인원이름 .

# 사고와 아차사고의 기록.
ex:안전사고 a owl:Class ;
    rdfs:label "안전 사고" ;
    tabnit:displayNameProperty ex:사고종류 .

# 위험 작업의 허가.
ex:작업허가 a owl:Class ;
    rdfs:label "작업 허가" ;
    tabnit:displayNameProperty ex:허가종류 .


# ── 관계 유형 ──────────────────────────────────────────────
# 영향 방향은 시연 자료의 영향 규칙을 따랐다. 퍼지지 않는 넷은 다른 시나리오를 옮길 때 다시 정한다.

# 법규가 바뀌면 그 법규가 부과한 요건이 영향을 받는다.
ex:요건부과 a owl:ObjectProperty ;
    rdfs:label "요건 부과" ;
    rdfs:domain ex:안전법규 ;
    rdfs:range  ex:법정요건 ;
    tabnit:impactDirection tabnit:SourceToTarget .

# 대상이 바뀌면 그 대상에 걸린 요건을 다시 본다. 요건에서 대상 쪽으로는 퍼지지 않는다 (D2 AD-287).
ex:요건적용 a owl:ObjectProperty ;
    rdfs:label "요건 적용" ;
    rdfs:domain ex:법정요건 ;
    rdfs:range  ex:안전관리대상 ;
    tabnit:impactDirection tabnit:TargetToSource .

# 물질안전자료가 바뀌면 그 물질이 영향을 받는다.
ex:자료기술 a owl:ObjectProperty ;
    rdfs:label "자료 기술" ;
    rdfs:domain ex:화학물질 ;
    rdfs:range  ex:물질안전자료 ;
    tabnit:impactDirection tabnit:TargetToSource .

# 물질이 바뀌면 그 물질을 쓰는 공정이 영향을 받는다.
ex:물질사용 a owl:ObjectProperty ;
    rdfs:label "물질 사용" ;
    rdfs:domain ex:제조공정 ;
    rdfs:range  ex:화학물질 ;
    tabnit:impactDirection tabnit:TargetToSource .

# 공정이 영향을 받으면 그 공정의 설비도 받는다.
ex:설비구성 a owl:ObjectProperty ;
    rdfs:label "설비 구성" ;
    rdfs:domain ex:제조공정 ;
    rdfs:range  ex:공정설비 ;
    tabnit:impactDirection tabnit:SourceToTarget .

# 공정이 영향을 받으면 그 공정에 배치된 인원도 받는다.
ex:인원배치 a owl:ObjectProperty ;
    rdfs:label "인원 배치" ;
    rdfs:domain ex:제조공정 ;
    rdfs:range  ex:작업인원 ;
    tabnit:impactDirection tabnit:SourceToTarget .

# 물질이 바뀌면 그 물질을 둔 보관소가 영향을 받는다.
ex:물질보관 a owl:ObjectProperty ;
    rdfs:label "물질 보관" ;
    rdfs:domain ex:화학물질 ;
    rdfs:range  ex:약품보관소 ;
    tabnit:impactDirection tabnit:SourceToTarget .

# 지금의 규칙은 이 관계로 영향을 퍼뜨리지 않는다.
ex:배기연결 a owl:ObjectProperty ;
    rdfs:label "배기 연결" ;
    rdfs:domain ex:제조공정 ;
    rdfs:range  ex:대기배출구 ;
    tabnit:impactDirection tabnit:None .

# 기록이다. 영향을 퍼뜨리지 않는다.
ex:사고관련 a owl:ObjectProperty ;
    rdfs:label "사고 관련" ;
    rdfs:domain ex:안전사고 ;
    rdfs:range  ex:안전관리대상 ;
    tabnit:impactDirection tabnit:None .

# 요건을 이행한 기록이다. 영향을 퍼뜨리지 않는다.
ex:이행증빙 a owl:ObjectProperty ;
    rdfs:label "이행 증빙" ;
    rdfs:domain ex:법정요건 ;
    rdfs:range  ex:작업인원 ;
    tabnit:impactDirection tabnit:None .

# 지금의 규칙은 이 관계로 영향을 퍼뜨리지 않는다.
ex:허가대상 a owl:ObjectProperty ;
    rdfs:label "허가 대상" ;
    rdfs:domain ex:작업허가 ;
    rdfs:range  ex:제조공정 ;
    tabnit:impactDirection tabnit:None .


# ── 속성 ───────────────────────────────────────────────────

ex:법규명칭 a owl:DatatypeProperty ;
    rdfs:label "법규 이름" ;
    rdfs:domain ex:안전법규 ;
    rdfs:range  xsd:string .

ex:시행일자 a owl:DatatypeProperty ;
    rdfs:label "시행일" ;
    rdfs:domain ex:안전법규 ;
    rdfs:range  xsd:date .

ex:요건명칭 a owl:DatatypeProperty ;
    rdfs:label "요건 이름" ;
    rdfs:domain ex:법정요건 ;
    rdfs:range  xsd:string .

ex:요건구분 a owl:DatatypeProperty ;
    rdfs:label "요건 구분" ;
    rdfs:domain ex:법정요건 ;
    rdfs:range  xsd:string .

ex:물질명칭 a owl:DatatypeProperty ;
    rdfs:label "물질 이름" ;
    rdfs:domain ex:화학물질 ;
    rdfs:range  xsd:string .

ex:특별관리여부 a owl:DatatypeProperty ;
    rdfs:label "특별관리 물질 여부" ;
    rdfs:domain ex:화학물질 ;
    rdfs:range  xsd:boolean .

ex:자료판번호 a owl:DatatypeProperty ;
    rdfs:label "자료의 판 번호" ;
    rdfs:domain ex:물질안전자료 ;
    rdfs:range  xsd:integer .

ex:자료개정일 a owl:DatatypeProperty ;
    rdfs:label "자료 개정일" ;
    rdfs:domain ex:물질안전자료 ;
    rdfs:range  xsd:date .

ex:유해성구분 a owl:DatatypeProperty ;
    rdfs:label "유해성 구분" ;
    rdfs:domain ex:물질안전자료 ;
    rdfs:range  xsd:string .

ex:노출기준값 a owl:DatatypeProperty ;
    rdfs:label "노출기준 값" ;
    rdfs:domain ex:물질안전자료 ;
    rdfs:range  xsd:decimal .

ex:자료특별관리 a owl:DatatypeProperty ;
    rdfs:label "자료에 적힌 특별관리 여부" ;
    rdfs:domain ex:물질안전자료 ;
    rdfs:range  xsd:boolean .

ex:공정명칭 a owl:DatatypeProperty ;
    rdfs:label "공정 이름" ;
    rdfs:domain ex:제조공정 ;
    rdfs:range  xsd:string .

ex:소속동 a owl:DatatypeProperty ;
    rdfs:label "소속 동" ;
    rdfs:domain ex:제조공정 ;
    rdfs:range  xsd:string .

ex:공정구역 a owl:DatatypeProperty ;
    rdfs:label "공정 구역" ;
    rdfs:domain ex:제조공정 ;
    rdfs:range  xsd:string .

ex:공정상태 a owl:DatatypeProperty ;
    rdfs:label "공정 상태" ;
    rdfs:domain ex:제조공정 ;
    rdfs:range  xsd:string .

ex:설비종류 a owl:DatatypeProperty ;
    rdfs:label "설비 종류" ;
    rdfs:domain ex:공정설비 ;
    rdfs:range  xsd:string .

ex:설비상태 a owl:DatatypeProperty ;
    rdfs:label "설비 상태" ;
    rdfs:domain ex:공정설비 ;
    rdfs:range  xsd:string .

ex:보관소명칭 a owl:DatatypeProperty ;
    rdfs:label "보관소 이름" ;
    rdfs:domain ex:약품보관소 ;
    rdfs:range  xsd:string .

ex:표지판번호 a owl:DatatypeProperty ;
    rdfs:label "표지에 적힌 자료의 판 번호" ;
    rdfs:domain ex:약품보관소 ;
    rdfs:range  xsd:integer .

ex:배출구명칭 a owl:DatatypeProperty ;
    rdfs:label "배출구 이름" ;
    rdfs:domain ex:대기배출구 ;
    rdfs:range  xsd:string .

ex:인원이름 a owl:DatatypeProperty ;
    rdfs:label "이름" ;
    rdfs:domain ex:작업인원 ;
    rdfs:range  xsd:string .

ex:인원역할 a owl:DatatypeProperty ;
    rdfs:label "역할" ;
    rdfs:domain ex:작업인원 ;
    rdfs:range  xsd:string .

ex:교육이수일 a owl:DatatypeProperty ;
    rdfs:label "교육 이수일" ;
    rdfs:domain ex:작업인원 ;
    rdfs:range  xsd:date .

ex:사고종류 a owl:DatatypeProperty ;
    rdfs:label "사고 종류" ;
    rdfs:domain ex:안전사고 ;
    rdfs:range  xsd:string .

ex:사고발생일 a owl:DatatypeProperty ;
    rdfs:label "사고 발생일" ;
    rdfs:domain ex:안전사고 ;
    rdfs:range  xsd:date .

ex:허가종류 a owl:DatatypeProperty ;
    rdfs:label "허가 종류" ;
    rdfs:domain ex:작업허가 ;
    rdfs:range  xsd:string .
