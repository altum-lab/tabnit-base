# 매핑. 형식은 D6 7절이다.
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tabnit: <urn:tabnit:vocab:> .
@prefix ex:     <urn:tabnit:pack:retirement-pension:> .

ex:매핑-institution a tabnit:Mapping ;
    tabnit:inputSourceId "institution" ;
    rdfs:label "금융기관 목록" ;
    tabnit:fileFormat tabnit:Csv ;
    tabnit:requiredColumns ( "기관번호" "기관명칭" "기관구분" "신용등급" "등급점수" ) ;
    tabnit:itemKeyColumns ( "기관번호" ) ;
    # 이 행이 나타내는 개체. 이 행에서 나온 변동의 근거가 된다 (D2 AD-120).
    tabnit:primaryEntity [ tabnit:entityType ex:금융기관 ; tabnit:keyColumn "기관번호" ] ;
    tabnit:entity [
        tabnit:entityType ex:금융기관 ;
        tabnit:keyColumn "기관번호" ;
        tabnit:attribute [ tabnit:property ex:기관명칭 ; tabnit:column "기관명칭" ] ;
        tabnit:attribute [ tabnit:property ex:기관구분 ; tabnit:column "기관구분" ] ;
        tabnit:attribute [ tabnit:property ex:신용등급 ; tabnit:column "신용등급" ] ;
        tabnit:attribute [ tabnit:property ex:등급점수 ; tabnit:column "등급점수" ]
    ] .
