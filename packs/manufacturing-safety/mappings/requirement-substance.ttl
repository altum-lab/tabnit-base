# 제조 안전 Pack. 반도체 제조 현장의 안전·보건·환경 업무를 본뜬 예시 Pack 이다 (D2 AD-49, AD-284 ~ AD-288).
# 모든 이름과 값은 지어낸 것이다. 실제 회사, 현장, 법령, 문서와 관계가 없다.
# 입력 자료 requirement-substance: 요건이 걸린 물질. 행은 관계만 담는다. 요건의 적용이 바뀐 것이므로 주 개체는 요건이다.
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tabnit: <urn:tabnit:vocab:> .
@prefix ex:     <urn:tabnit:pack:manufacturing-safety:> .

ex:매핑-requirement-substance a tabnit:Mapping ;
    tabnit:inputSourceId "requirement-substance" ;
    rdfs:label "법정요건별 화학물질" ;
    tabnit:fileFormat tabnit:Csv ;
    tabnit:requiredColumns ( "요건번호" "물질번호" ) ;
    tabnit:itemKeyColumns ( "요건번호" "물질번호" ) ;
    # 이 행이 나타내는 개체. 이 행에서 나온 변동의 근거가 된다 (D2 AD-120).
    tabnit:primaryEntity [ tabnit:entityType ex:법정요건 ; tabnit:keyColumn "요건번호" ] ;
    tabnit:relation [
        tabnit:relationType ex:요건적용 ;
        tabnit:sourceEntity [ tabnit:entityType ex:법정요건 ; tabnit:keyColumn "요건번호" ] ;
        tabnit:targetEntity [ tabnit:entityType ex:화학물질 ; tabnit:keyColumn "물질번호" ]
    ] .
